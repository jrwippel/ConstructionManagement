@model WebAppSystems.Models.Execucao

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Execucao</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ObraId" class="control-label"></label>
                <select asp-for="ObraId" class="form-control" asp-items="ViewBag.ObraId" id="obraDropdown"></select>
            </div>
            <div class="form-group">
                <label asp-for="EtapaId" class="control-label"></label>
                <select asp-for="EtapaId" class="form-control" asp-items="ViewBag.EtapaId" id="etapaDropdown" disabled="disabled"></select>
            </div>
            <div class="form-group">
                <label asp-for="ServicoId" class="control-label"></label>
                <select asp-for="ServicoId" class="form-control" asp-items="ViewBag.ServicoId" id="servicoDropdown" disabled="disabled"></select>
            </div>
            <div class="form-group">
                <label asp-for="PercentualExecucao" class="control-label"></label>                
                <input asp-for="PercentualExecucao" class="form-control" type="number" step="0.01" min="0" lang="pt-BR" />
                <span asp-validation-for="PercentualExecucao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById("obraDropdown").addEventListener("change", function () {
            var obraId = this.value;

            if (obraId) {
                fetch(`/Execucaos/GetEtapasEServicos?obraId=${obraId}`)
                    .then(response => response.json())
                    .then(data => {
                        var etapaDropdown = document.getElementById("etapaDropdown");
                        var servicoDropdown = document.getElementById("servicoDropdown");

                        etapaDropdown.innerHTML = "";
                        servicoDropdown.innerHTML = "";

                        if (data.etapas.length > 0) {
                            etapaDropdown.disabled = false;
                            data.etapas.forEach(etapa => {
                                var option = new Option(etapa.descricao, etapa.id);
                                etapaDropdown.add(option);
                            });
                        } else {
                            etapaDropdown.disabled = true;
                        }

                        if (data.servicos.length > 0) {
                            servicoDropdown.disabled = false;
                            data.servicos.forEach(servico => {
                                var option = new Option(servico.descricao, servico.id);
                                servicoDropdown.add(option);
                            });
                        } else {
                            servicoDropdown.disabled = true;
                        }
                    });
            } else {
                document.getElementById("etapaDropdown").disabled = true;
                document.getElementById("servicoDropdown").disabled = true;
            }
        });
    </script>
}

