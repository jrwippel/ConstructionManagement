@using WebAppSystems.Models
@{
    var obra = ViewBag.Obra as Obra;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<h2 class="text-center mb-4">Dashboard da Obra: <strong>@obra.Descricao</strong></h2>

<div id="dashboardContainer" data-obra-id="@obra.Id">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <label class="form-label">Selecione a Etapa:</label>          
            <input type="hidden" id="etapaIdFoto" value="@ViewBag.EtapaId" />

            <select id="etapaDropdown"
                    class="form-control"
                    asp-items="ViewBag.Etapas"
                    data-etapa-selecionada="@ViewBag.EtapaSelecionada">
            </select>
            <div class="mt-4">
                <label>Progresso da Execução:</label>
                <div class="progress" style="height: 28px;">
                    <div id="barraProgresso" class="progress-bar bg-success"
                         role="progressbar" style="width: 0%"
                         aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        0%
                    </div>
                </div>
            </div>
        </div>
    </div>

    <button id="abrirModalNovoServico" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#modalCadastrarServico">
        <i class="bi bi-plus-circle"></i> Cadastrar Novo Serviço
    </button>
    <button id="abrirModalAnexarFotos" class="btn btn-info mb-3" data-bs-toggle="modal" data-bs-target="#modalAnexarFotos">
        <i class="bi bi-camera"></i> Anexar Fotos
    </button>
    <button id="btnVisualizarFotos" class="btn btn-secondary mb-3" data-bs-toggle="modal" data-bs-target="#modalVisualizarFotos">
        <i class="bi bi-images"></i> Visualizar Fotos
    </button>
    <button id="btnGerarRelatorio" class="btn btn-dark mb-3">
        <i class="bi bi-file-earmark-pdf"></i> Gerar Relatório PLS (PDF)
    </button>



    <div class="modal fade" id="modalAnexarFotos" tabindex="-1" aria-labelledby="modalLabelFotos" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <input type="hidden" id="etapaIdFoto" value="" />

                <div class="modal-header">
                    <h5 class="modal-title">Anexar Fotos à Etapa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-grid gap-2">
                        <label class="btn btn-outline-primary">
                            <i class="bi bi-camera"></i> Tirar Foto com a Câmera
                            <input type="file" id="fotoCamera" accept="image/*" capture="environment" hidden>
                        </label>

                        <label class="btn btn-outline-secondary">
                            <i class="bi bi-image"></i> Escolher da Galeria
                            <input type="file" id="fotoGaleria" accept="image/*" hidden>
                        </label>
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="descricaoImagem" class="form-label">Descrição da Imagem</label>
                        <textarea id="descricaoImagem" class="form-control" rows="2" placeholder="Digite uma descrição..."></textarea>
                    </div>
                    <button class="btn btn-success mt-3 w-100" id="btnEnviarFoto" disabled>Enviar Foto</button>



                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalVisualizarFotos" tabindex="-1" aria-labelledby="modalFotosLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Fotos da Etapa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="listaFotosEtapa" class="row g-3"></div>
                </div>
            </div>
        </div>
    </div>






    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div style="max-height: 400px; overflow-y: auto;">
                <table class="table table-striped table-bordered mb-0">
                    <thead class="table-light text-center sticky-top">
                        <tr>
                            <th>Serviço</th>
                            <th>Incidência (%)</th>
                            <th>Execução (%)</th>
                            <th>Executado</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var servico in obra.Servico)
                        {
                            <tr>
                                <td>@servico.Descricao</td>
                                <td class="text-center">@servico.PercentualIncidencia%</td>
                                <td>
                                    <input type="number" class="form-control execucaoInput text-center"
                                           data-servico-id="@servico.Id"
                                           data-incidencia="@servico.PercentualIncidencia" />
                                </td>
                                <td class="resultadoExecucao text-center">0%</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-secondary editar-servico"
                                            data-id="@servico.Id"
                                            data-descricao="@servico.Descricao"
                                            data-incidencia="@servico.PercentualIncidencia.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <button id="salvarExecucao" class="btn btn-success px-4">
            <i class="bi bi-check-circle me-2"></i>Salvar Execução
        </button>
    </div>
</div>

<div class="modal fade" id="modalCadastrarServico" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <input type="hidden" name="Id" id="ServicoId" value="0" />

            <div class="modal-header">
                <h5 class="modal-title">Novo Serviço para a Obra</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formCadastroServico">
                    <input type="hidden" name="ObraId" value="@obra.Id" />
                    <div class="mb-3">
                        <label>Descrição do Serviço</label>
                        <input type="text" class="form-control" name="Descricao" required />
                    </div>
                    <div class="mb-3">
                        <label>Percentual de Incidência (%)</label>
                        <input type="number" class="form-control" name="PercentualIncidencia" required step="0.01" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" id="btnSalvarServico">Salvar Serviço</button>
                <button class="btn btn-danger d-none" id="btnExcluirServico">Excluir Serviço</button>

            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            const obraId = parseInt($('#dashboardContainer').data('obra-id'));
            const etapaPadrao = $('#etapaDropdown').data('etapa-selecionada');

            aplicarListenersDeInput();
            atualizarBarraProgresso();

            // Aguarde o carregamento do DOM, depois acione o evento .change
            if (etapaPadrao) {
                setTimeout(() => {
                    $('#etapaDropdown').val(etapaPadrao).trigger('change');
                }, 100); // pequeno delay para garantir que os elementos estejam prontos
            }

            $('#btnGerarRelatorio').click(function () {
                const obraId = $('#dashboardContainer').data('obra-id');
                const etapa = $('#etapaDropdown').val();

                if (!etapa) {
                    alert("Selecione uma etapa para gerar o relatório.");
                    return;
                }

                window.open(`/Obras/GerarRelatorioPLS?obraId=${obraId}&etapa=${etapa}`, '_blank');
            });


            $('#btnVisualizarFotos').click(function () {
                const etapaId = $('#etapaIdFoto').val();
                const numeroEtapaId = $('#etapaDropdown').val();

                $.get(`/Obras/ListarFotosPorEtapa?etapaId=${etapaId}&numeroEtapaId=${numeroEtapaId}`, function (fotos) {
                    const container = $('#listaFotosEtapa');
                    container.empty();

                    if (fotos.length === 0) {
                        container.html('<p class="text-muted">Nenhuma foto encontrada para esta etapa.</p>');
                        return;
                    }

                    fotos.forEach(foto => {
                        const card = `
                        <div class="col-md-4">
                            <div class="card">
                                <img src="${foto.url}" class="card-img-top" alt="Foto etapa">
                                <div class="card-body text-center">
                                    <button class="btn btn-danger btn-sm excluir-foto" data-id="${foto.id}">
                                        <i class="bi bi-trash3"></i> Excluir
                                    </button>
                                </div>
                            </div>
                        </div>`;
                        container.append(card);
                    });
                });
            });


            $(document).on('click', '.excluir-foto', function () {
                const fotoId = $(this).data('id');

                if (confirm("Deseja realmente excluir esta foto?")) {
                    $.ajax({
                        url: `/Obras/ExcluirFoto?fotoId=${fotoId}`,
                        method: 'POST',
                        success: function () {
                            $('#btnVisualizarFotos').trigger('click'); // Atualiza a lista
                        },
                        error: function () {
                            alert("Erro ao excluir a foto.");
                        }
                    });
                }
            });



            let arquivoSelecionado = null;

            $('#fotoCamera, #fotoGaleria').change(function () {
                arquivoSelecionado = this.files[0];
                if (arquivoSelecionado) {
                    $('#btnEnviarFoto').prop('disabled', false);
                }
            });

            $('#btnEnviarFoto').click(function () {
                if (!arquivoSelecionado) return;

                const descricao = $('#descricaoImagem').val();
                const etapaId = $('#etapaIdFoto').val();
                const numeroEtapaId = $('#etapaDropdown').val();

                const formData = new FormData(); // ✅ declare aqui ANTES de usar
                formData.append("descricao", descricao);
                formData.append("etapaId", etapaId);
                formData.append("numeroEtapaId", numeroEtapaId);
                formData.append("arquivo", arquivoSelecionado);

                $.ajax({
                    url: "/Obras/UploadImagemEtapa",
                    method: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function () {
                        alert("Imagem enviada com sucesso!");
                        arquivoSelecionado = null;
                        $('#btnEnviarFoto').prop('disabled', true);
                        $('#descricaoImagem').val(""); // limpa o campo de descrição
                    },
                    error: function () {
                        alert("Erro ao enviar imagem.");
                    }
                });
            });



            $('#abrirModalNovoServico').click(function () {
                $('#ServicoId').val(0);
                $('#formCadastroServico')[0].reset();
                $('#modalCadastrarServico .modal-title').text('Novo Serviço para a Obra'); // 🔁 define título padrão
            });

            $('#etapaDropdown').change(function () {
                const etapaSelecionada = parseInt($(this).val());
                const obraId = $("#dashboardContainer").data("obra-id");

                $.get('/Obras/ObterExecucoesPorEtapa', { obraId: obraId, etapa: etapaSelecionada }, function (data) {
                    $('tbody tr').each(function () {
                        const inputExecucao = $(this).find('.execucaoInput');
                        const campoResultado = $(this).find('.resultadoExecucao');
                        const incidencia = parseFloat(inputExecucao.data('incidencia').toString().replace(',', '.'));
                        const servicoId = inputExecucao.data('servico-id');
                        const execucaoAtual = data.execucoesAtuais.find(e => e.servicoId == servicoId);
                        const execucaoAnterior = data.execucoesAnteriores.find(e => e.servicoId == servicoId);

                        if (execucaoAtual) {
                            const percentualAtual = parseFloat(execucaoAtual.percentualExecucao.toString().replace(',', '.'));
                            inputExecucao.val(percentualAtual);
                            campoResultado.text(`${((percentualAtual * incidencia) / 100).toFixed(2)}%`);
                        } else if (execucaoAnterior) {
                            const percentualAnterior = parseFloat(execucaoAnterior.percentualExecucao.toString().replace(',', '.'));
                            inputExecucao.val(percentualAnterior); // Sugere apenas se não houver valor atual
                            campoResultado.text(`${((percentualAnterior * incidencia) / 100).toFixed(2)}%`);
                        } else {
                            inputExecucao.val('');
                            campoResultado.text('0%');
                        }
                    });

                    aplicarListenersDeInput();
                    atualizarBarraProgresso();
                });
            });


            function aplicarListenersDeInput() {
                $('.execucaoInput').off('input').on('input', function () {
                    const incidencia = parseFloat($(this).data('incidencia').toString().replace(',', '.'));
                    const valorDigitado = parseFloat($(this).val().toString().replace(',', '.'));
                    const campoResultado = $(this).closest('tr').find('.resultadoExecucao');

                    if (!isNaN(incidencia) && !isNaN(valorDigitado)) {
                        const calculo = ((valorDigitado * incidencia) / 100).toFixed(2);
                        campoResultado.text(`${calculo}%`);
                    } else {
                        campoResultado.text('0%');
                    }

                    atualizarBarraProgresso();
                });
            }

            function atualizarBarraProgresso() {
                let total = 0;

                $('.execucaoInput').each(function () {
                    const incidencia = parseFloat($(this).data('incidencia').toString().replace(',', '.'));
                    const valor = parseFloat($(this).val().toString().replace(',', '.'));
                    if (!isNaN(incidencia) && !isNaN(valor)) {
                        total += (incidencia * valor) / 100;
                    }
                });

                const totalFormatado = total.toFixed(2);
                const barra = $('#barraProgresso');
                barra.css('width', `${totalFormatado}%`)
                    .attr('aria-valuenow', totalFormatado)
                    .text(`${totalFormatado}%`);

                barra.removeClass('bg-success bg-warning bg-danger');
                if (total < 30)
                    barra.addClass('bg-danger');
                else if (total < 70)
                    barra.addClass('bg-warning text-dark');
                else
                    barra.addClass('bg-success');
            }

            aplicarListenersDeInput();
            atualizarBarraProgresso();

            $('#salvarExecucao').click(function () {
                const etapaSelecionada = $('#etapaDropdown').val();

                if (!etapaSelecionada) {
                    alert("Selecione uma etapa válida antes de salvar.");
                    return;
                }

                const dadosParaSalvar = [];

                $('.execucaoInput').each(function () {
                    const valor = parseFloat($(this).val().toString().replace(',', '.'));
                    const servicoId = $(this).data('servico-id');

                    if (!isNaN(valor)) {
                        dadosParaSalvar.push({
                            obraId: obraId,
                            etapaId: etapaSelecionada,
                            servicoId: servicoId,
                            percentualExecucao: valor
                        });
                    }
                });

                $.ajax({
                    url: '/Obras/SalvarExecucoes',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dadosParaSalvar),
                    success: function () {
                        alert('Execuções salvas com sucesso!');
                    },
                    error: function (xhr) {
                        const mensagemErro = xhr.responseText || 'Erro ao salvar execuções.';
                        alert(mensagemErro);
                    }

                });
            });

            $(document).on('click', '.editar-servico', function () {
                const botao = $(this);
                const servicoId = botao.data('id');

                $('#ServicoId').val(servicoId);
                $('input[name="Descricao"]').val(botao.data('descricao'));
                $('input[name="PercentualIncidencia"]').val(botao.data('incidencia'));
                $('#modalCadastrarServico .modal-title').text('Editar Serviço');
                $('#modalCadastrarServico').modal('show');

                // Consulta ao backend para verificar execuções
                $.get(`/Obras/VerificarExecucoes?servicoId=${servicoId}`, function (data) {
                    if (!data.temExecucoes) {
                        $('#btnExcluirServico').removeClass('d-none'); // Exibe o botão
                    } else {
                        $('#btnExcluirServico').addClass('d-none'); // Oculta o botão
                    }
                });
            });

            $('#btnExcluirServico').click(function () {
                const servicoId = $('#ServicoId').val();
                console.log("Serviço ID:", servicoId); // 🔎 Debug

                if (!servicoId || servicoId == "0") {
                    alert("Erro: ID do serviço inválido.");
                    return;
                }

                if (confirm("Tem certeza que deseja excluir este serviço? Essa ação não pode ser desfeita!")) {
                    $.ajax({
                        url: `/Servicoes/Remover?servicoId=${servicoId}`,
                        method: 'POST',
                        success: function () {
                            alert("Serviço excluído com sucesso!");
                            $('#modalCadastrarServico').modal('hide');
                            $('#etapaDropdown').trigger('change');
                        },
                        error: function (xhr) {
                            alert("Erro ao excluir serviço: " + xhr.responseText);
                        }
                    });
                }
            });

            $('#btnSalvarServico').click(function () {
                const servico = {
                    id: parseInt($('#ServicoId').val()), // ← agora pega o ID real, ou 0 se novo
                    descricao: $('input[name="Descricao"]').val(),
                    obraId: parseInt($('input[name="ObraId"]').val()),
                    percentualIncidencia: parseFloat($('input[name="PercentualIncidencia"]').val().replace(',', '.'))
                };

                const url = servico.id === 0 ? '/Servicoes/SalvarServicos' : '/Servicoes/AtualizarServicos';


                $.ajax({
                    url: '/Servicoes/SalvarServicos',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(servico),
                    success: function () {
                        $('#modalCadastrarServico').modal('hide');
                        $('#formCadastroServico')[0].reset();

                        // 🔄 Atualizar tabela de serviços via Ajax
                        $.get(`/Obras/ListarServicos?obraId=${servico.obraId}`, function (html) {
                            $('table tbody').html(html);
                            aplicarListenersDeInput();
                            atualizarBarraProgresso();
                            $('#etapaDropdown').trigger('change'); // ✅ aqui está o pulo do gato!
                        });

                    },
                    error: function (xhr) {
                        alert('Erro ao salvar: ' + xhr.responseText);
                    }
                });

            });

        });
    </script>
}
