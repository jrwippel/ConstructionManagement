@using System.Globalization
@using WebAppSystems.Models.ViewModels
@model IEnumerable<ObraComExecucaoViewModel>

<style>
    .obra-card {
        background: #fff;
        padding: 20px;
        margin-bottom: 15px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        cursor: pointer;
        transition: 0.3s ease-in-out;
    }

        .obra-card:hover {
            transform: scale(1.01);
        }

    .progress {
        width: 100%;
        height: 28px;
        background-color: #eee;
        border-radius: 10px;
        overflow: hidden;
        margin-top: 10px;
    }


    .progress-bar {
        height: 100%;
        background-color: #007bff;
        text-align: center;
        color: white;
        font-weight: bold;
    }
</style>

<h1>Obras em andamento</h1>
<p>
    <a asp-action="Create" class="btn btn-success">Cadastrar Nova Obra</a>
</p>

@foreach (var item in Model)
{
    <div class="obra-card" onclick="window.location.href='@Url.Action("Dashboard", "Obras", new { id = item.Obra.Id })'">
        <h5>@item.Obra.Descricao</h5>
        <div class="progress">
            <div class="progress-bar" style="width:@item.PercentualConclusao.ToString(CultureInfo.InvariantCulture)%">
                @item.PercentualConclusao%
            </div>
        </div>
    </div>
}
